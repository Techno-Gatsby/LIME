{
  "name": "clementine",
  "version": "1.0.0",
  "description": "Offline file converter, PDF editor and media toolkit for Windows",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "fetch-engines": "node scripts/fetch-binaries.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dist": "electron-builder --win --x64",
    "test": "node test/engines.test.js",
    "dist:installer": "node scripts/make-installer.mjs"
  },
  "keywords": [],
  "author": "Clementine",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "@pdf-lib/fontkit": "^1.1.1",
    "ag-psd": "^31.0.3",
    "docx": "^9.12.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "heic-decode": "^2.1.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "mupdf": "^1.28.1",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@fluentui/svg-icons": "^1.1.344",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "pe-library": "^2.0.1",
    "resedit": "^2.0.3"
  },
  "productName": "Clementine",
  "build": {
    "appId": "com.clementine.converter",
    "productName": "Clementine",
    "asar": false,
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/tray.png",
      "build/drag.png",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__,docs,example,examples,.github}/**",
      "!**/*.{md,markdown,ts,tsbuildinfo}",
      "!**/LICENSE.md.bak",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/@img/sharp-linux*/**",
      "!node_modules/@img/sharp-libvips-linux*/**",
      "!node_modules/@img/sharp-linuxmusl*/**",
      "!node_modules/@img/sharp-wasm32/**",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor/bin/win32",
        "to": "bin"
      },
      {
        "from": "vendor/data",
        "to": "data"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clementine",
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "heic",
          "heif",
          "webp",
          "avif"
        ],
        "name": "Image",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "rar",
          "7z",
          "tar",
          "gz",
          "tgz"
        ],
        "name": "Archive",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}